# Base URL of the FastAPI backend, reachable FROM THE PHONE (no trailing slash).
#
# "localhost" will NOT work on a physical device - that resolves to the phone itself.
# Use your computer's LAN IP and make sure the backend is bound to 0.0.0.0:
#     uvicorn main:app --host 0.0.0.0 --port 8000
#
# Android emulator can also use the special host alias http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.3:8000
