# --- Google Cloud Vision ---
# API key with the Cloud Vision API enabled.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key

# --- Groq ---
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# --- Optional ---
# Comma-separated list of origins allowed to call this API.
# Add your machine's LAN origin (e.g. http://192.168.0.3:3000) when opening the
# web app from a phone. The React Native app sends no Origin header, so CORS
# does not gate it - but it does need the server bound to 0.0.0.0:
#     uvicorn main:app --host 0.0.0.0 --port 8000
ALLOWED_ORIGINS=http://localhost:3000

# Groq model used for structured field extraction.
GROQ_MODEL=llama-3.3-70b-versatile

# Max upload size in megabytes.
MAX_UPLOAD_MB=10

# --- Batch scanning ---
# Max files accepted per POST /api/scan/batch request.
MAX_BATCH_FILES=10
# How many files in a batch are OCR'd/extracted at once. Kept low by default -
# Groq's free tier caps at 12,000 tokens/minute and one extraction uses roughly
# 2,000-2,200 of them, so a handful of concurrent requests can exhaust the
# whole budget in a single burst. Raise it if you're on a paid Groq tier.
BATCH_CONCURRENCY=2

# --- Database / auth ---
# SQLite file by default; point elsewhere (e.g. postgresql://...) if you outgrow it.
DATABASE_URL=sqlite:///./app.db

# Secret used to sign login JWTs. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

# Credentials for the first admin account, created by `python seed.py`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
