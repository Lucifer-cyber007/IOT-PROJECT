# --- Google Cloud Vision ---
# API key with the Cloud Vision API enabled.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key

# --- Groq ---
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# --- Optional ---
# Comma-separated list of origins allowed to call this API.
# Add your machine's LAN origin (e.g. http://192.168.0.3:3000) when opening the
# web app from a phone. The React Native app sends no Origin header, so CORS
# does not gate it - but it does need the server bound to 0.0.0.0:
#     uvicorn main:app --host 0.0.0.0 --port 8000
ALLOWED_ORIGINS=http://localhost:3000

# Groq model used for structured field extraction.
GROQ_MODEL=llama-3.3-70b-versatile

# Max upload size in megabytes.
MAX_UPLOAD_MB=10

# Set to 1 to return mock data without calling Vision/Groq (useful for frontend
# development and for smoke-testing the server before you have API keys).
MOCK_MODE=0
