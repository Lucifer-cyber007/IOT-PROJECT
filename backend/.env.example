# --- Google Cloud Vision (OCR) ---
# API key with the Cloud Vision API enabled.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key

# --- Vertex AI (structured field extraction, via Gemini) ---
# Vertex AI authenticates with a service account, not a simple API key. Setup:
#   1. In the Google Cloud Console, enable the "Vertex AI API" for your project.
#   2. Enable billing on the project - Vertex AI has no permanent free tier.
#   3. Create a service account and grant it the "Vertex AI User" role
#      (roles/aiplatform.user):
#        gcloud iam service-accounts create bill-extractor \
#          --display-name="Electricity Bill Extractor"
#        gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#          --member="serviceAccount:bill-extractor@YOUR_PROJECT_ID.iam.gserviceaccount.com" \
#          --role="roles/aiplatform.user"
#   4. Create and download a JSON key for it, and point the path below at it:
#        gcloud iam service-accounts keys create ./vertex-service-account.json \
#          --iam-account=bill-extractor@YOUR_PROJECT_ID.iam.gserviceaccount.com
#   Keep the downloaded JSON file OUT of git. The repo's root .gitignore matches
#   "*service-account*.json" and "*-key.json" - name the file to match one of
#   those patterns (the example name below already does), and double-check with
#   `git status` before ever committing near it.
GOOGLE_APPLICATION_CREDENTIALS=./vertex-service-account.json
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_REGION=us-central1

# The Gemini model used for structured field extraction. flash-lite is the
# cheapest tier and is sufficient for this structured-extraction task; move up
# to gemini-2.5-flash if you see accuracy issues on hard bills.
VERTEX_MODEL=gemini-2.5-flash-lite

# --- Optional ---
# Comma-separated list of origins allowed to call this API.
# Add your machine's LAN origin (e.g. http://192.168.0.3:3000) when opening the
# web app from a phone. The React Native app sends no Origin header, so CORS
# does not gate it - but it does need the server bound to 0.0.0.0:
#     uvicorn main:app --host 0.0.0.0 --port 8000
ALLOWED_ORIGINS=http://localhost:3000

# Max upload size in megabytes.
MAX_UPLOAD_MB=10

# How many bills a single /api/extract-batch request will accept, and how many
# of them are processed concurrently. Keep concurrency modest relative to your
# Vertex AI quota - see the README for guidance.
MAX_BATCH_FILES=25
BATCH_CONCURRENCY=2
BATCH_STAGGER_SECONDS=0.4

# Set to 1 to return mock data without calling Vision/Vertex AI (useful for
# frontend development and for smoke-testing the server before you have keys).
MOCK_MODE=0
